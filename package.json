{
  "name": "moss-mini-demo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.13 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm --filter @moss-mini-demo/report-schema build",
    "format:check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true .",
    "lint": "biome lint --vcs-enabled=true --vcs-client-kind=git --vcs-use-ignore-file=true .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:package-import": "node packages/report-schema/test/public-entry.smoke.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test:package-import && pnpm test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
