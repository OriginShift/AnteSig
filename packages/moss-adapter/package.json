{
  "name": "@moss-mini-demo/moss-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:live": "pnpm --filter @moss-mini-demo/report-schema build && pnpm build && node --conditions=react-server test/live/live-smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@moss-mini-demo/report-schema": "workspace:*",
    "canonicalize": "3.0.0",
    "server-only": "0.0.1",
    "viem": "2.55.11"
  }
}
